NODE_ENV=development
PORT=4000
# Optional in development. If omitted, Adfix uses a persistent embedded database.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/adfix_pm
# Optional path for the zero-config embedded database.
# PGLITE_DATA_DIR=.data/pglite
# LOCAL_UPLOAD_DIR=.data/uploads
# Optional built frontend directory for single-service mode.
# WEB_DIST_DIR=../web/dist
APP_ORIGIN=http://localhost:5173
REFRESH_COOKIE_NAME=adfix_refresh
# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=52428800
JWT_ACCESS_SECRET=replace-with-a-long-random-string-32-plus-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32-plus-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000
REFRESH_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173
SEED_PROFILE=admin_only
SEED_ADMIN_EMAIL=admin@adfix.local
SEED_ADMIN_NAME=Adfix Admin
# Development bootstrap only. In production, set a unique password for the first
# startup, then remove it after the administrator has been created.
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_DEMO_USER_PASSWORD=DemoUser123!
